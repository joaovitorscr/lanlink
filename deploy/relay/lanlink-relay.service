[Unit]
Description=lanlink iroh relay
After=network-online.target
Wants=network-online.target

[Service]
# Plain HTTP behind a reverse proxy. For built-in TLS instead, use e.g.:
#   ExecStart=/usr/local/bin/lanlink-relay --http-addr 0.0.0.0:80 --https-addr 0.0.0.0:443 \
#     --acme-domain relay.example.com --acme-contact you@example.com --stun
ExecStart=/usr/local/bin/lanlink-relay --http-addr 127.0.0.1:3340
Environment=RUST_LOG=info
DynamicUser=yes
StateDirectory=lanlink-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
